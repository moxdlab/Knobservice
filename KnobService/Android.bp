android_app {
   name: "KnobService",
   srcs: ["src/**/*.kt"],
   libs: ["android.car"],
   manifest: "AndroidManifest.xml",
   platform_apis: true,
   certificate: "platform",
   required: [
       "privapp-permissions-knob.xml",
       "Vendor_0483_Product_5750.idc"
   ],
   privileged: true,
   static_libs: [
       "androidx.core_core",
   ],
}

prebuilt_etc {
   name: "privapp-permissions-knob.xml",
   sub_dir: "permissions",
   src: "privapp-permissions-knob.xml",
   filename_from_src: true,
}

prebuilt_etc {
   name: "Vendor_0483_Product_5750.idc",
   sub_dir: "idc",
   src: "Vendor_0483_Product_5750.idc",
   filename_from_src: true,
}
